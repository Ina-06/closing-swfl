# Copy this file to .env.local and fill it in. .env.local is gitignored.
# The six NEXT_PUBLIC_ values and every secret below go into Vercel.

# --- Firebase, browser side -------------------------------------------------
# From Firebase console → Project settings → General → Your apps → Web app.
# These are public by design: they identify the project, they do not grant
# access to it. Access is decided by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Secrets ----------------------------------------------------------------
# The shared station key. Anyone with it can open the app, so treat it like a
# door code: long, not a word, changed if it gets out.
APP_ACCESS_KEY=

# The MT team's own code. Opens the MT portal (inventory counts) and nothing
# else; the station key above cannot open it.
MT_ACCESS_KEY=

# The entire contents of the service account JSON file, on one line, from the
# opening brace to the closing one. Firebase console → Project settings →
# Service accounts → Generate new private key.
#
# NEVER commit this value or the downloaded file. It bypasses every rule above.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Server-only, for the 7 AM job and the filed PDFs -----------------------
# Vercel sends this as "Authorization: Bearer <value>" on every scheduled call
# to /api/cron/autoclose, and the route refuses anything else. Long and random;
# it never leaves the server. Locally, pass it yourself to test the job:
#   curl -H "Authorization: Bearer $CRON_SECRET" "http://localhost:3000/api/cron/autoclose?dryRun=1"
CRON_SECRET=

# The Storage bucket the closing sheets are filed in, without gs:// — Firebase
# console → Storage, e.g. your-project.firebasestorage.app. Read and written
# only through the service account above; storage.rules denies every client.
FIREBASE_STORAGE_BUCKET=

# --- Van registration reminders (Resend) ------------------------------------
# /api/cron/registration runs daily and emails 7, 5, 3 and 1 day before a
# van's registration expires. Test without sending anything:
#   curl -H "Authorization: Bearer $CRON_SECRET" "http://localhost:3000/api/cron/registration?dryRun=1"
#
# Resend → API Keys. Sending access is enough.
RESEND_API_KEY=
# Must be on a domain verified in Resend → Domains, e.g.
#   SWFL Fleet <fleet@yourdomain.com>
REGISTRATION_EMAIL_FROM=
# Optional: where replies go, comma-separated.
REGISTRATION_EMAIL_REPLY_TO=
# The office, comma-separated. Every reminder for every van.
REGISTRATION_EMAIL_TO=
# Each vendor's addresses, as one line of JSON. Names match the Vendor column
# in the vans database, ignoring case and spaces. Several addresses: "a@x.com, b@x.com".
#   VENDOR_EMAILS={"Vendor A":"fleet@vendor-a.com","Vendor B":"a@b.com, c@b.com"}
VENDOR_EMAILS=
