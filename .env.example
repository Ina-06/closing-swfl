# Copy this file to .env.local and fill it in. .env.local is gitignored.
# The same six NEXT_PUBLIC_ values plus the two secrets go into Vercel.

# --- Firebase, browser side -------------------------------------------------
# From Firebase console → Project settings → General → Your apps → Web app.
# These are public by design: they identify the project, they do not grant
# access to it. Access is decided by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Secrets ----------------------------------------------------------------
# The shared station key. Anyone with it can open the app, so treat it like a
# door code: long, not a word, changed if it gets out.
APP_ACCESS_KEY=

# The entire contents of the service account JSON file, on one line, from the
# opening brace to the closing one. Firebase console → Project settings →
# Service accounts → Generate new private key.
#
# NEVER commit this value or the downloaded file. It bypasses every rule above.
FIREBASE_SERVICE_ACCOUNT_KEY=
