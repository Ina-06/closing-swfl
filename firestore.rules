rules_version = '2';

// Closing — SWFL
//
// This file is the actual security boundary. The login screen and the RoleGate
// component are convenience; these rules are what stop someone who has the
// project id (it ships in the client bundle, by design) from reading or
// writing station data.
//
// Two principles run through the whole file:
//   1. Field ownership. The dispatcher owns what the driver texted in; the
//      closer owns what happened at the station. Neither can overwrite the
//      other's columns, so a stale phone can never clobber a live edit.
//   2. Nothing is ever deleted except a mistaken entry, and only by the
//      dispatcher. Sessions are permanent — closing sets status, it does not
//      remove the night.
//
// Paste this into Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // The role claim is minted server-side in /api/login and signed by the
    // service account. A client cannot forge or edit it.
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    // A one-time code is a closer with a clock on it and a kill switch.
    //
    // Both are checked here rather than in the app, so neither depends on a
    // phone behaving. `keyExp` is stamped into the token when the code is
    // redeemed; `revokedAt` is read live, which is what lets the dispatcher cut
    // off a stand-in who is already holding an open phone.
    //
    // get() inside rules is not itself subject to rules, so the accessKeys
    // collection stays closed to every client while this can still read it.
    function onetimeLive() {
      let keyId = request.auth.token.get('keyId', '');
      return request.auth.token.get('keyExp', 0) > request.time.toMillis()
             && keyId != ''
             && exists(/databases/$(database)/documents/accessKeys/$(keyId))
             && get(/databases/$(database)/documents/accessKeys/$(keyId))
                  .data.get('revokedAt', null) == null;
    }

    // Ordered so the two permanent roles never touch the lookup above. A
    // mistake in it can cost a stand-in their session; it must never be able
    // to cost Karim his.
    function signedIn() {
      return role() == 'dispatcher'
             || role() == 'closer'
             || (role() == 'onetime' && onetimeLive());
    }

    function isDispatcher() {
      return role() == 'dispatcher';
    }

    function isCloser() {
      return role() == 'closer' || (role() == 'onetime' && onetimeLive());
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The roster. Read by both screens, maintained by the dispatcher.
    //
    // Deletable, unlike sessions: the session roster and every entry carry
    // their own copy of the full name, so removing a driver here leaves every
    // sheet already written reading exactly as it did before.
    match /drivers/{driverId} {
      allow read: if signedIn();

      // Create is open to both roles: a driver can turn up in the yard without
      // ever having been announced, and the closer has to be able to put a name
      // to him there and then. Renaming and removing stay with the dispatcher —
      // that is roster upkeep, not something to do one-handed in the dark.
      allow create: if signedIn();
      allow update, delete: if isDispatcher();
    }

    match /sessions/{sessionId} {
      // The closer's only session-level job is End Day: flip the status and
      // attach the PDF. Everything else about the night is the dispatcher's.
      function closerSessionFields() {
        return changedKeys().hasOnly([
          'status', 'closedAt', 'pdfUrl', 'updatedAt', 'updatedBy'
        ]);
      }

      allow read: if signedIn();
      allow create: if isDispatcher();
      allow update: if isDispatcher() || (isCloser() && closerSessionFields());
      allow delete: if false;

      match /entries/{entryId} {
        // What the driver texted the dispatcher.
        //
        // `status` and `clockOutManual` are here as well as on the closer's
        // list: task drivers and BUDs often report their own clock-out over
        // the phone, and the dispatcher marks them clocked out from their end.
        // The stamped `clockOut` timestamp stays closer-only — that one is
        // evidence, not hearsay.
        function dispatcherFields() {
          return changedKeys().hasOnly([
            'seq', 'driverId', 'fullName', 'isBud', 'isTrainer', 'isRescuer',
            'eta', 'returnsRaw', 'returnsCount', 'returnsReasons',
            'returnsMismatch', 'performance', 'metric', 'infractions',
            'rescues', 'notes', 'clockOutManual', 'status',
            'updatedAt', 'updatedBy'
          ]);
        }

        // What happened when the van pulled in. `cell` is the old name for
        // `mobile`, kept in the list so a night written before the checks grew
        // to six can still be corrected.
        function closerFields() {
          return changedKeys().hasOnly([
            'status', 'clockOut', 'van', 'vanIssues',
            'fuel', 'key', 'charger', 'mobile', 'snack', 'lights', 'cell',
            'addedByCloser', 'updatedAt', 'updatedBy'
          ]);
        }

        allow read: if signedIn();

        // Both roles create: the dispatcher as drivers text in, the closer
        // when someone arrives unannounced.
        allow create: if signedIn();

        allow update: if (isDispatcher() && dispatcherFields())
                      || (isCloser() && closerFields());

        // Only for an entry typed by mistake, and only from the dispatcher's
        // table. The closer has no delete path anywhere.
        allow delete: if isDispatcher();
      }
    }

    // One-time closer codes. Written and verified only by the Admin SDK, which
    // bypasses these rules — so no client gets near the hashes, including the
    // dispatcher's. Their screen goes through /api/keys instead.
    match /accessKeys/{keyId} {
      allow read, write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
