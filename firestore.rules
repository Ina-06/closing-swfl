rules_version = '2';

// Closing — SWFL
//
// This file is the actual security boundary. The login screen and the RoleGate
// component are convenience; these rules are what stop someone who has the
// project id (it ships in the client bundle, by design) from reading or
// writing station data.
//
// Two principles run through the whole file:
//   1. Field ownership. The dispatcher owns what the driver texted in; the
//      closer owns what happened at the station. Neither can overwrite the
//      other's columns, so a stale phone can never clobber a live edit.
//   2. Nothing is ever deleted except a mistaken entry, and only by the
//      dispatcher. Sessions are permanent — closing sets status, it does not
//      remove the night.


//
// Paste this into Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // The role claim is minted server-side in /api/login and signed by the
    // service account. A client cannot forge or edit it.
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    // A one-time code is a closer with a clock on it and a kill switch.
    //
    // Both are checked here rather than in the app, so neither depends on a
    // phone behaving. `keyExp` is stamped into the token when the code is
    // redeemed; `revokedAt` is read live, which is what lets the dispatcher cut
    // off a stand-in who is already holding an open phone.
    //
    // get() inside rules is not itself subject to rules, so the accessKeys
    // collection stays closed to every client while this can still read it.
    function onetimeLive() {
      let keyId = request.auth.token.get('keyId', '');
      return request.auth.token.get('keyExp', 0) > request.time.toMillis()
             && keyId != ''
             && exists(/databases/$(database)/documents/accessKeys/$(keyId))
             && get(/databases/$(database)/documents/accessKeys/$(keyId))
                  .data.get('revokedAt', null) == null;
    }

    // Ordered so the two permanent roles never touch the lookup above. A
    // mistake in it can cost a stand-in their session; it must never be able
    // to cost Karim his.
    function signedIn() {
      return role() == 'dispatcher'
             || role() == 'closer'
             || role() == 'hr'
             || (role() == 'onetime' && onetimeLive());
    }

    function isDispatcher() {
      return role() == 'dispatcher';
    }

    function isCloser() {
      return role() == 'closer' || (role() == 'onetime' && onetimeLive());
    }

    // HR reads tonight and writes one map on it. Every other rule in this file
    // is silent about them, which means no — the catch-all at the bottom and
    // the hasOnly lists above it do the work, and nothing has to remember to
    // exclude a role that was never included.
    function isHr() {
      return role() == 'hr';
    }

    // The repairs board, and nothing else in the database.
    //
    // Deliberately absent from signedIn(). Every other role is a way of
    // looking at a night; this one cannot read a night at all — not the
    // roster, not an ETA, not a clock-out, not an infraction. The repairs
    // collection carries its own copy of the van, the driver's name and the
    // date it came off, so there is nothing about the close left for this role
    // to need. Adding it to signedIn() would hand it the whole sheet in
    // exchange for nothing.
    function isRepairs() {
      return role() == 'repairs';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The roster. Read by both screens, maintained by the dispatcher.
    //
    // Deletable, unlike sessions: the session roster and every entry carry
    // their own copy of the full name, so removing a driver here leaves every
    // sheet already written reading exactly as it did before.
    match /drivers/{driverId} {
      allow read: if signedIn();

      // Create is open to both roles: a driver can turn up in the yard without
      // ever having been announced, and the closer has to be able to put a name
      // to him there and then. Renaming and removing stay with the dispatcher —
      // that is roster upkeep, not something to do one-handed in the dark.
      //
      // Named rather than `signedIn()`, so adding a fourth role later cannot
      // hand it the power to invent a driver by accident. HR is that role: they
      // search the names already on tonight and write against one of them.
      allow create: if isDispatcher() || isCloser();
      allow update, delete: if isDispatcher();
    }

    match /sessions/{sessionId} {
      // The closer's session-level jobs: End Day — flip the status and attach
      // the PDF — and the notes he leaves himself about drivers who have no row
      // yet. Everything else about the night is the dispatcher's.
      //
      // `rosterNotes` is his own map and nothing else's. `roster` and
      // `totalExpected` are not on this list, so writing a note can never
      // reshape the night: who is on tonight stays the dispatcher's to say.
      function closerSessionFields() {
        return changedKeys().hasOnly([
          'status', 'closedAt', 'pdfUrl', 'rosterNotes', 'updatedAt', 'updatedBy'
        ]);
      }

      // HR's one write in the whole database.
      //
      // `timeEdits` and nothing else — not `roster`, not `status`, not
      // `closedAt`. HR is reconciling hours against a night somebody else is
      // running, and there is no field on this document they should be able to
      // reach except the one they own. They cannot create a session either: a
      // night starts when dispatch posts the roster, and an HR paste landing on
      // an empty date would invent a night that nobody worked.
      function hrSessionFields() {
        return changedKeys().hasOnly(['timeEdits', 'updatedAt', 'updatedBy']);
      }

      allow read: if signedIn();
      allow create: if isDispatcher();
      allow update: if isDispatcher()
                    || (isCloser() && closerSessionFields())
                    || (isHr() && hrSessionFields());
      allow delete: if false;

      match /entries/{entryId} {
        // What the driver texted the dispatcher.
        //
        // `status` and `clockOutManual` are here as well as on the closer's
        // list: task drivers and BUDs often report their own clock-out over
        // the phone, and the dispatcher marks them clocked out from their end.
        // The stamped `clockOut` timestamp stays closer-only — that one is
        // evidence, not hearsay.
        function dispatcherFields() {
          return changedKeys().hasOnly([
            'seq', 'driverId', 'fullName', 'isBud', 'isTrainer', 'isRescuer',
            'eta', 'returnsRaw', 'returnsCount', 'returnsReasons',
            'returnsMismatch', 'performance', 'metric', 'infractions',
            'rescues', 'notes', 'clockOutManual', 'status',
            'updatedAt', 'updatedBy'
          ]);
        }

        // What happened when the van pulled in. `cell` is the old name for
        // `mobile`, kept in the list so a night written before the checks grew
        // past three can still be corrected.
        //
        // Every check in CHECKS has to be named here. This file is the one part
        // of the app that does not ship with the deploy, so a phone that knows
        // nine checks against a rule file that knows seven has two tiles that
        // bounce every tap — see describeWriteError in ArrivalSheet, which
        // exists for exactly that mistake.
        //
        // `notes` is on both lists, and it is the only field that is. It is one
        // note per driver — the amber strip on his card and at the top of his
        // sheet — and it has to be writable from the yard as well as the desk,
        // because half of what needs saying about a driver only becomes true
        // when his van pulls in. Both editors open with what is already there,
        // so sharing it adds text rather than replacing it.
        //
        // `secondTrip` is deliberately absent: it is written once when the row
        // is created and is the reason that row exists, so nothing should be
        // able to turn a second trip into a first one afterwards.
        function closerFields() {
          return changedKeys().hasOnly([
            'status', 'clockOut', 'van', 'vanOk', 'vanIssues', 'grounded',
            'fuel', 'key', 'charger', 'mobile', 'snack', 'lights', 'cell',
            'bungees', 'doors', 'tires', 'addedByCloser', 'notes',
            'updatedAt', 'updatedBy'
          ]);
        }

        allow read: if signedIn();

        // Both roles create: the dispatcher as drivers text in, the closer
        // when someone arrives unannounced. Named for the same reason as the
        // drivers collection — HR reads this sheet and writes nothing on it.
        allow create: if isDispatcher() || isCloser();

        allow update: if (isDispatcher() && dispatcherFields())
                      || (isCloser() && closerFields());

        // Only for an entry typed by mistake, and only from the dispatcher's
        // table. The closer has no delete path anywhere.
        allow delete: if isDispatcher();
      }
    }

    // The repairs board. A to-do list that outlives the night it came off.
    //
    // Top-level rather than under a session, because a repair is not part of
    // one. It is opened on a night in August and ticked off in September, and
    // hanging it off the night it came from would mean the board could only be
    // assembled by reading every session there has ever been.
    //
    // Two roles reach it and they reach it very differently:
    //
    //   - repairs owns it. Read the board, add to it, tick a job off, correct
    //     a line, remove one typed by mistake.
    //   - closer only ever posts to it. End Day reads what is already open so
    //     it does not file the same broken mirror seven nights running, then
    //     writes one job per van issue. It cannot tick anything off and cannot
    //     change or remove a job, because a van being fixed is not something
    //     that happens in the yard at midnight.
    //
    // Note which role is *not* here. The dispatcher runs the night and has the
    // widest hand in this file everywhere else; the board is no part of the
    // night, so they have nothing on it. HR the same. Neither had to be
    // excluded — they were simply never included, which is what the catch-all
    // at the bottom is for.
    match /repairs/{repairId} {
      // Every field a job is allowed to have. Unlike an entry, this is not a
      // record two roles own half of each — it is one job, written by whoever
      // is holding it, so there is no split to enforce and the list is here to
      // keep a field nobody has thought about from being invented on it.
      function repairFields() {
        return [
          'title', 'van', 'detail', 'grounded', 'source', 'nightKey',
          'driverName', 'matchKey', 'done', 'doneAt',
          'createdAt', 'updatedAt', 'updatedBy'
        ];
      }

      allow read: if isRepairs() || isCloser();

      // A new job has to be the whole shape and nothing more.
      allow create: if (isRepairs() || isCloser())
                    && request.resource.data.keys().hasOnly(repairFields());

      // Ticking a job off, and correcting what one says. The closer is not on
      // this line on purpose — see above.
      //
      // What *changed*, not what the document contains — the same test every
      // other update in this file makes, and the difference is not academic.
      // Checking the whole document means one stray field, on one job, written
      // by hand in the console or left behind by a future version, makes that
      // job impossible to tick off for ever: the box bounces, the row snaps
      // back, and nothing on the board explains why. A rule that can strand a
      // real repair is worse than one that lets an unknown field sit there
      // being ignored.
      allow update: if isRepairs() && changedKeys().hasOnly(repairFields());

      // Only for a job typed by mistake. The board asks twice before it calls
      // this, and a job that was genuinely done is ticked off instead, which
      // keeps it in the archive.
      allow delete: if isRepairs();
    }

    // One-time closer codes. Written and verified only by the Admin SDK, which
    // bypasses these rules — so no client gets near the hashes, including the
    // dispatcher's. Their screen goes through /api/keys instead.
    match /accessKeys/{keyId} {
      allow read, write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
