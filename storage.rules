rules_version = '2';

// Closing — SWFL, Storage
//
// This app does not use Storage at all. The spreadsheet is downloaded and
// pasted into the station's shared workbook; the PDF is shared straight into
// the WhatsApp group. Both are rendered fresh from the night's entries every
// time they are asked for, which is what Past nights does — the entries are the
// record, and a second copy of a file in a bucket is a thing to keep, not an
// archive.
//
// The file stays here as a lock on a door we are not using. If Storage is ever
// switched on in the console it starts on a default rule that lets any signed-in
// user read and write, and this app has signed-in users. These files would carry
// every driver's full name, so the default is not one to leave standing.
//
// If Storage is turned on: Firebase console → Storage → Rules → paste → Publish.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
