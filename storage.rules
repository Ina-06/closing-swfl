rules_version = '2';

// Closing — SWFL, Storage
//
// Storage holds one thing: the closing sheet PDF filed for every night when it
// closes, under sheets/{night}/. It is written by End Day's /api/sheet/archive
// and by the 7 AM job, and read by /api/sheet/archived — all three on the
// server, with the service account, which these rules do not apply to.
//
// So no client reads or writes anything here, ever, and this file says so.
// The PDFs carry every driver's full name and clock-out; the only way to one is
// through the same signed-in role check as rebuilding the sheet. No public or
// signed download URL is ever handed out.
//
// Firebase console → Storage → Rules → paste → Publish. Storage's default rule
// lets any signed-in user read and write, and this app has signed-in users.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
